---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { url } from '../../lib/url';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = 'Word Game Blog: Strategy, Word Lists & Dictionary Guides';
const description =
  'Wordle strategy, Scrabble word lists worth memorizing, and dictionary deep-dives from Find Five Letter Words.';

const crumbs = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
];

const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const blocks = ['bg-mint', 'bg-cream', 'bg-pink', 'bg-lilac', 'bg-lime', 'bg-coral'];
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs crumbs={crumbs} />

  <h1 class="mt-8 text-4xl font-snug tracking-display text-balance sm:text-5xl">
    Word game blog
  </h1>
  <p class="mt-6 max-w-3xl text-lg">
    Strategy guides, lists worth memorizing, and the occasional dictionary rabbit hole, all written
    around the same frequency-sorted word data that powers the finder.
  </p>

  <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      posts.map((post, i) => (
        <li>
          <a
            href={url(`/blog/${post.id}/`)}
            class="block h-full rounded-3xl p-6 text-blockink transition-transform hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
            class:list={blocks[i % blocks.length]}
          >
            <p class="font-monoui text-xs uppercase tracking-eyebrow">
              {fmt.format(post.data.pubDate)}
            </p>
            <p class="mt-3 text-xl font-snug tracking-display text-balance">{post.data.title}</p>
            <p class="mt-3 font-soft">{post.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
