---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const title = 'Contact | Find Five Letter Words';
const description =
  'Contact findfiveletterwords.com to report a missing word, suggest a list, or ask a question.';
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-3xl pt-16">
    <p class="font-monoui text-xs uppercase tracking-eyebrow">Get in touch</p>
    <h1 class="mt-5 text-4xl font-snug tracking-display text-balance sm:text-5xl">Contact</h1>
    <p class="mt-8 text-lg">
      Found a word that should not be on a list, or one that is missing? Want a new kind of list?
      We read everything.
    </p>
    <p class="mt-4">
      Email us at
      <a href="mailto:contact@findfiveletterwords.com" class="font-mid underline underline-offset-4">
        contact@findfiveletterwords.com</a
      > and include the page URL if you are reporting a list issue; it makes fixes much faster.
    </p>
    <p class="mt-4">
      For privacy questions, see our
      <a href={url('/privacy-policy/')} class="font-mid underline underline-offset-4">privacy policy</a>.
    </p>
  </section>
</BaseLayout>
