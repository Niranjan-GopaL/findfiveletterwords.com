---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LinkGroups from '../../components/LinkGroups.astro';
import LengthTabs from '../../components/LengthTabs.astro';
import WordGrid from '../../components/WordGrid.astro';
import { hubFor, type HubData } from '../../lib/pages';
import { LENGTHS, LENGTH_NAMES, WORD_LISTS, formatCount, sectionFor } from '../../lib/words';

export function getStaticPaths() {
  return LENGTHS.map((len) => ({
    params: { section: sectionFor(len) },
    props: { hub: hubFor(len) },
  }));
}

interface Props {
  hub: HubData;
}

const { hub } = Astro.props;
const name = LENGTH_NAMES[hub.len];
const count = formatCount(hub.wordCount);

// Short lengths: the full list fits on the hub page itself (a major query,
// e.g. "two letter words"). Longer lengths get link directories only.
const inlineList = hub.wordCount <= 1200 ? WORD_LISTS[hub.len] : null;

const crumbs = [
  { href: '/', label: 'Home' },
  { href: `/${hub.section}/`, label: `${hub.len}-Letter Words` },
];
---

<BaseLayout title={hub.title} description={hub.description}>
  <Breadcrumbs crumbs={crumbs} />

  <h1 class="mt-8 text-4xl font-snug tracking-display text-balance sm:text-5xl">
    {hub.h1}
  </h1>

  <p class="mt-6 max-w-3xl text-lg">
    Every {name}-letter word list on this site, organised so you can jump straight to the pattern
    you need. All {count}
    {name}-letter words come from the tournament word lists, and every list is sorted with the most
    common words first — with Scrabble points shown for each word.
  </p>
  <p class="mt-4 max-w-3xl font-soft">
    Already know some letters? The <a href="/" class="font-mid underline underline-offset-4">word finder</a>
    filters all {count} words by position, included letters, and excluded letters in an instant —
    it works like a cheat sheet for Wordle, Scrabble, and Words With Friends.
  </p>

  <div class="mt-8">
    <LengthTabs current={hub.len} />
  </div>

  {inlineList && <WordGrid words={inlineList} />}

  <LinkGroups groups={hub.groups} />
</BaseLayout>
