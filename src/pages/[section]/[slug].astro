---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WordGrid from '../../components/WordGrid.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import LinkGroups from '../../components/LinkGroups.astro';
import TipBox from '../../components/TipBox.astro';
import LengthTabs from '../../components/LengthTabs.astro';
import { allPages, type PageDef } from '../../lib/pages';
import { lengthForSection } from '../../lib/words';

export function getStaticPaths() {
  return allPages().map((page) => ({
    params: { section: page.section, slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: PageDef;
}

const { page } = Astro.props;
const len = lengthForSection(page.section)!;

const sectionLabel = `${len}-Letter Words`;
const crumbs = [
  { href: '/', label: 'Home' },
  { href: `/${page.section}/`, label: sectionLabel },
  { href: `/${page.section}/${page.slug}/`, label: page.h1 },
];
---

<BaseLayout title={page.title} description={page.description}>
  <Breadcrumbs crumbs={crumbs} />

  <h1 class="mt-8 text-4xl font-snug tracking-display text-balance sm:text-5xl">
    {page.h1}
  </h1>

  {
    page.intro.map((para, i) => (
      <p class={i === 0 ? 'mt-6 max-w-3xl text-lg' : 'mt-4 max-w-3xl font-soft'}>{para}</p>
    ))
  }

  <div class="mt-8">
    <LengthTabs current={len} />
  </div>

  <TipBox tip={page.tip} />

  <WordGrid words={page.words} />

  <FaqBlock faqs={page.faqs} />

  <LinkGroups groups={page.linkGroups} />
</BaseLayout>
