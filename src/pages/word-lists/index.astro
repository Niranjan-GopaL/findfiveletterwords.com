---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { LENGTHS, LENGTH_NAMES, WORD_LISTS, formatCount, sectionFor, topWords } from '../../lib/words';

const title = 'Word Lists by Length — 2 to 15 Letter Words';
const description =
  'Browse every word list from 2-letter to 15-letter words: tournament-legal, sorted by frequency, with Scrabble points. Free lists for Wordle, Scrabble & crosswords.';

const crumbs = [
  { href: '/', label: 'Home' },
  { href: '/word-lists/', label: 'Word Lists' },
];

const blocks = ['bg-lime', 'bg-lilac', 'bg-cream', 'bg-mint', 'bg-pink', 'bg-coral'];
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs crumbs={crumbs} />

  <h1 class="mt-8 text-4xl font-snug tracking-display text-balance sm:text-5xl">
    Word lists by length
  </h1>
  <p class="mt-6 max-w-3xl text-lg">
    From two-letter Scrabble savers to fifteen-letter crossword monsters — every word in the
    tournament lists, organised by length. Each list is sorted by how common the word is in
    everyday English, so likely answers come first.
  </p>

  <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      LENGTHS.map((l, i) => (
        <li>
          <a
            href={`/${sectionFor(l)}/`}
            class="block h-full rounded-3xl p-6 text-blockink transition-transform hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
            class:list={blocks[i % blocks.length]}
          >
            <p class="font-monoui text-xs uppercase tracking-eyebrow tabular-nums">
              {formatCount(WORD_LISTS[l].length)} words
            </p>
            <p class="mt-3 text-2xl font-snug tracking-display">
              {LENGTH_NAMES[l][0].toUpperCase() + LENGTH_NAMES[l].slice(1)}-letter words
            </p>
            <p class="mt-2 font-soft">Most common: {topWords(WORD_LISTS[l], 3).toLowerCase()}</p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
