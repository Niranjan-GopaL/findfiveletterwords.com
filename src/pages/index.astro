---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqBlock from '../components/FaqBlock.astro';
import LinkGroups from '../components/LinkGroups.astro';
import { allPagesFor, type LinkGroup } from '../lib/pages';
import { ALPHABET, LENGTHS, WORD_LISTS, formatCount, sectionFor } from '../lib/words';
import { url } from '../lib/url';

const totalWords = formatCount(LENGTHS.reduce((sum, l) => sum + WORD_LISTS[l].length, 0));

const title = 'Find Five Letter Words: Free Word Finder for Wordle & Scrabble';
const description = `Free word finder for Wordle, Scrabble & Words With Friends. Filter ${totalWords} words (2-20 letters) by position and letters, across five dictionaries, with points.`;

const specialSlugs = [
  'with-no-repeated-letters',
  'without-vowels',
  'with-double-letters',
  'with-four-vowels',
  'with-q-but-no-u',
];

const browseGroups: LinkGroup[] = [
  {
    heading: 'Word lists by length',
    links: [
      ...LENGTHS.map((l) => ({
        href: `/${sectionFor(l)}/`,
        label: `${l}-letter (${formatCount(WORD_LISTS[l].length)})`,
      })),
      { href: '/word-lists/', label: 'All lengths →' },
    ],
  },
  {
    heading: '5-letter words starting with…',
    links: ALPHABET.map((c) => ({
      href: `/5-letter-words/starting-with-${c}/`,
      label: c.toUpperCase(),
    })),
  },
  {
    heading: 'Special 5-letter lists',
    links: allPagesFor(5)
      .filter((p) => specialSlugs.includes(p.slug))
      .map((p) => ({ href: `/${p.section}/${p.slug}/`, label: p.h1 })),
  },
];

const faqs = [
  {
    q: 'What dictionaries does Find Five Letter Words use?',
    a: `Five: the combined tournament list (default), the curated Wordle answer list, Words With Friends (ENABLE), Scrabble US (TWL06), and Scrabble UK (SOWPODS): ${totalWords} words of 2 to 20 letters in total. Switch between them in the finder settings.`,
  },
  {
    q: 'How do I use the finder for Wordle?',
    a: 'Type your green letters into the matching position boxes, put yellow letters in the "contains" field, and put gray letters in the "exclude" field. The list updates as you type, with the most likely answers at the top. For endgame precision, switch the dictionary to "Wordle answers".',
  },
  {
    q: 'Why are words sorted by frequency instead of alphabetically?',
    a: 'Puzzle answers are almost always everyday words. Ranking by real-world frequency puts likely answers in the first rows instead of hiding them mid-alphabet. You can switch to alphabetical or points order in settings.',
  },
  {
    q: 'Is the word finder free?',
    a: 'Yes. It is completely free, with no sign-up and no download. The site is supported by a small amount of advertising.',
  },
];
---

<BaseLayout title={title} description={description} home>
  <!-- Hero -->
  <section class="pt-14 text-center sm:pt-20">
    <p class="font-monoui text-xs uppercase tracking-eyebrow">
      Wordle · Scrabble · Words With Friends · Crosswords
    </p>
    <h1 class="mx-auto mt-5 max-w-4xl text-5xl font-soft tracking-display text-balance sm:text-7xl">
      Find the word you need
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg">
      A free word finder with every 2-to-20-letter word in the major game dictionaries, sorted by
      how common each word is, so the answer you need sits near the top.
    </p>
  </section>

  <!-- Finder tool -->
  <section class="mx-auto mt-12 max-w-4xl" aria-labelledby="finder-heading">
    <h2 id="finder-heading" class="sr-only">Word finder</h2>
    <form
      id="finder"
      class="rounded-3xl bg-lilac p-5 text-blockink max-sm:-mx-4 max-sm:rounded-none sm:p-8"
      novalidate
    >
      <div class="flex flex-wrap items-start justify-between gap-4">
        <fieldset class="min-w-0">
          <legend class="font-monoui text-xs uppercase tracking-eyebrow">Word length</legend>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {
              LENGTHS.map((l) => (
                <span>
                  <input
                    type="radio"
                    name="len"
                    id={`len-${l}`}
                    value={l}
                    checked={l === 5}
                    class="peer sr-only"
                  />
                  <label
                    for={`len-${l}`}
                    class="block min-w-10 cursor-pointer rounded-full border border-blockink/25 px-3 py-1.5 text-center text-sm font-mid transition-colors peer-checked:bg-blockink peer-checked:text-canvas peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-blockink hover:bg-canvas/40"
                  >
                    {l}
                  </label>
                </span>
              ))
            }
          </div>
        </fieldset>
      </div>

      <fieldset class="mt-7">
        <legend class="flex items-center gap-2 font-monoui text-xs uppercase tracking-eyebrow">
          <span class="size-2.5 rounded-full border border-blockink/40 bg-success" aria-hidden="true"></span>
          Correct letters in position (green)
        </legend>
        <div id="positions" class="mt-3 flex flex-wrap gap-1.5">
          {
            Array.from({ length: 20 }, (_, i) => i + 1).map((p) => (
              <input
                id={`pos-${p}`}
                name={`pos-${p}`}
                type="text"
                maxlength="1"
                aria-label={`Letter in position ${p}`}
                autocomplete="off"
                autocapitalize="characters"
                spellcheck="false"
                class:list={[
                  'h-12 w-11 rounded-md border border-blockink/25 bg-canvas/70 text-center text-lg font-snug uppercase text-ink transition-colors focus:border-blockink focus:outline-none',
                  p > 5 && 'hidden',
                ]}
                disabled={p > 5}
              />
            ))
          }
        </div>
      </fieldset>

      <div class="mt-7 grid gap-6 sm:grid-cols-2">
        <div>
          <label for="contains" class="flex items-center gap-2 font-monoui text-xs uppercase tracking-eyebrow">
            <span class="size-2.5 rounded-full border border-blockink/40 bg-wordle-yellow" aria-hidden="true"></span>
            Contains these letters (yellow)
          </label>
          <input
            id="contains"
            name="contains"
            type="text"
            placeholder="e.g. RT…"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            class="mt-2 h-12 w-full rounded-md border border-blockink/25 bg-canvas/70 px-3.5 text-lg uppercase text-ink transition-colors placeholder:normal-case placeholder:text-ink/50 focus:border-blockink focus:outline-none"
          />
        </div>
        <div>
          <label for="excludes" class="flex items-center gap-2 font-monoui text-xs uppercase tracking-eyebrow">
            <span class="size-2.5 rounded-full border border-blockink/40 bg-blockink/30" aria-hidden="true"></span>
            Exclude these letters (gray)
          </label>
          <input
            id="excludes"
            name="excludes"
            type="text"
            placeholder="e.g. SLON…"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            class="mt-2 h-12 w-full rounded-md border border-blockink/25 bg-canvas/70 px-3.5 text-lg uppercase text-ink transition-colors placeholder:normal-case placeholder:text-ink/50 focus:border-blockink focus:outline-none"
          />
        </div>
      </div>

      <details id="settings" class="mt-7 rounded-2xl bg-canvas/50">
        <summary class="flex h-12 cursor-pointer list-none items-center gap-2 rounded-2xl px-4 font-mid marker:hidden [&::-webkit-details-marker]:hidden">
          <svg class="size-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
          Settings: dictionary, sort &amp; points
        </summary>
        <div class="grid gap-6 px-4 pb-5 pt-1 sm:grid-cols-3">
          <fieldset>
            <legend class="font-monoui text-xs uppercase tracking-eyebrow">Dictionary</legend>
            <div class="mt-2 space-y-1.5 text-base">
              {
                [
                  ['all', 'All dictionaries'],
                  ['wordle', 'Wordle answers (5-letter)'],
                  ['wwf', 'Words With Friends'],
                  ['twl', 'Scrabble US (TWL)'],
                  ['csw', 'Scrabble UK (CSW)'],
                ].map(([value, label], i) => (
                  <label for={`dict-${value}`} class="flex cursor-pointer items-center gap-2.5">
                    <input type="radio" name="dict" id={`dict-${value}`} value={value} checked={i === 0} class="size-4 accent-blockink" />
                    {label}
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset>
            <legend class="font-monoui text-xs uppercase tracking-eyebrow">Sort results</legend>
            <div class="mt-2 space-y-1.5 text-base">
              {
                [
                  ['common', 'Most common first'],
                  ['az', 'A to Z'],
                  ['points', 'Highest points'],
                ].map(([value, label], i) => (
                  <label for={`sort-${value}`} class="flex cursor-pointer items-center gap-2.5">
                    <input type="radio" name="sort" id={`sort-${value}`} value={value} checked={i === 0} class="size-4 accent-blockink" />
                    {label}
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset>
            <legend class="font-monoui text-xs uppercase tracking-eyebrow">Display</legend>
            <label for="show-points" class="mt-2 flex cursor-pointer items-center gap-2.5 text-base">
              <input type="checkbox" id="show-points" checked class="size-4 accent-blockink" />
              Show points on words
            </label>
            <p class="mt-2 text-sm font-soft">
              Points follow the selected dictionary (WWF or Scrabble values).
            </p>
          </fieldset>
        </div>
      </details>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <button
          type="reset"
          class="rounded-full bg-blockink px-7 py-2.5 text-base font-mid text-canvas transition-opacity hover:opacity-85"
        >
          Reset
        </button>
        <p id="count" aria-live="polite" class="font-monoui text-xs uppercase tracking-eyebrow tabular-nums">
          Loading word list…
        </p>
        <p class="ml-auto font-monoui text-xs uppercase tracking-eyebrow max-sm:hidden">
          Press <kbd class="rounded border border-blockink/25 px-1.5 py-0.5">?</kbd> for shortcuts
        </p>
      </div>

      <noscript>
        <p class="mt-6">
          The interactive finder needs JavaScript. No problem: browse the
          <a href={url('/5-letter-words/')} class="font-mid underline underline-offset-4">full 5-letter word lists</a>
          instead.
        </p>
      </noscript>
    </form>

    <ul
      id="results"
      class="mt-6 grid grid-cols-[repeat(auto-fill,minmax(6.5rem,1fr))] gap-2"
      aria-label="Matching words"
    >
    </ul>
    <div class="mt-6 text-center">
      <button
        id="more"
        type="button"
        hidden
        class="rounded-full bg-inverse-canvas px-6 py-2.5 text-sm font-mid text-inverse-ink transition-opacity hover:opacity-85"
      >
        Show more words
      </button>
    </div>
  </section>

  <!-- Browse -->
  <section class="mt-20 border-t border-hairline pt-2">
    <LinkGroups groups={browseGroups} />
  </section>

  <!-- Editorial -->
  <section class="mt-20 rounded-3xl bg-cream p-6 text-blockink max-sm:-mx-4 max-sm:rounded-none sm:p-12">
    <h2 class="text-2xl font-snug tracking-display text-balance sm:text-3xl">
      Why frequency order beats alphabetical
    </h2>
    <p class="mt-5 max-w-3xl">
      Most word lists are alphabetical, which hides the answer you actually need somewhere in the
      middle of the Cs. Every list on this site is ranked by how often each word appears in a
      trillion-word corpus of written English. Puzzle answers are almost always everyday words, so
      they surface in the first rows, not after three screens of obscure tournament plays.
    </p>
    <h2 class="mt-10 text-2xl font-snug tracking-display text-balance sm:text-3xl">
      Which dictionary should I use?
    </h2>
    <p class="mt-5 max-w-3xl">
      Playing Wordle? "Wordle answers" narrows the list to the curated answer pool. Scrabble players
      should match their rulebook: TWL in North America, CSW everywhere else. Words With Friends
      uses its own list, based on ENABLE. When in doubt, "All dictionaries" searches everything:
      {totalWords} words.
    </p>
  </section>

  <FaqBlock faqs={faqs} />
</BaseLayout>

<script>
  // Small screens get a shorter first page of results to keep the links
  // and editorial sections within reach; "Show more" covers the rest.
  const initialCount = () => (matchMedia('(max-width: 640px)').matches ? 40 : 120);
  const PAGE_SIZE = 480;

  const FLAGS: Record<string, number> = { wwf: 1, twl: 2, csw: 4, wordle: 8 };
  const SCRABBLE: Record<string, number> = {
    a: 1, b: 3, c: 3, d: 2, e: 1, f: 4, g: 2, h: 4, i: 1, j: 8, k: 5, l: 1, m: 3,
    n: 1, o: 1, p: 3, q: 10, r: 1, s: 1, t: 1, u: 1, v: 4, w: 4, x: 8, y: 4, z: 10,
  };
  const WWF: Record<string, number> = {
    a: 1, b: 4, c: 4, d: 2, e: 1, f: 4, g: 3, h: 3, i: 1, j: 10, k: 5, l: 2, m: 4,
    n: 2, o: 1, p: 4, q: 10, r: 1, s: 1, t: 1, u: 2, v: 5, w: 4, x: 8, y: 3, z: 10,
  };

  const form = document.getElementById('finder') as HTMLFormElement;
  const results = document.getElementById('results') as HTMLUListElement;
  const countEl = document.getElementById('count') as HTMLParagraphElement;
  const moreBtn = document.getElementById('more') as HTMLButtonElement;
  const posInputs = Array.from({ length: 20 }, (_, i) =>
    document.getElementById(`pos-${i + 1}`),
  ) as HTMLInputElement[];
  const containsEl = document.getElementById('contains') as HTMLInputElement;
  const excludesEl = document.getElementById('excludes') as HTMLInputElement;
  const showPointsEl = document.getElementById('show-points') as HTMLInputElement;

  type Dict = { w: string[]; f: number[] };
  const cache: Record<number, Dict> = {};
  let matches: string[] = [];
  let rendered = 0;
  let timer: number | undefined;

  const PREFS_KEY = 'fflw-solver-prefs';
  function loadPrefs() {
    try {
      const p = JSON.parse(localStorage.getItem(PREFS_KEY) ?? '{}');
      if (p.dict) setRadio('dict', p.dict);
      if (p.sort) setRadio('sort', p.sort);
      if (p.points === false) showPointsEl.checked = false;
    } catch {
      /* fresh visitor */
    }
  }
  function savePrefs() {
    try {
      localStorage.setItem(
        PREFS_KEY,
        JSON.stringify({ dict: radio('dict'), sort: radio('sort'), points: showPointsEl.checked }),
      );
    } catch {
      /* private mode */
    }
  }
  function radio(name: string): string {
    return (form.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement)?.value ?? '';
  }
  function setRadio(name: string, value: string) {
    const el = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
    if (el && !el.disabled) el.checked = true;
  }

  function currentLen(): number {
    return Number(radio('len')) || 5;
  }

  const BASE_URL = import.meta.env.BASE_URL.replace(/\/$/, '');
  async function loadDict(len: number): Promise<Dict> {
    if (!cache[len]) {
      const res = await fetch(`${BASE_URL}/data/dicts-${len}.json`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      cache[len] = (await res.json()) as Dict;
    }
    return cache[len];
  }

  function letters(value: string): string[] {
    return [...new Set(value.toLowerCase().replace(/[^a-z]/g, ''))];
  }

  function score(w: string): number {
    const table = radio('dict') === 'wwf' ? WWF : SCRABBLE;
    let s = 0;
    for (const ch of w) s += table[ch] ?? 0;
    return s;
  }

  function applyFilter(dict: Dict): string[] {
    const len = currentLen();
    const dictKey = radio('dict');
    const bit = FLAGS[dictKey] ?? 0;
    const greens = posInputs
      .slice(0, len)
      .map((el) => el.value.toLowerCase().replace(/[^a-z]/g, ''));
    const contains = letters(containsEl.value);
    // A "gray" letter that is also green/yellow means "no more copies";
    // dropping it entirely is the forgiving interpretation.
    const keep = new Set([...greens.filter(Boolean), ...contains]);
    const excludes = letters(excludesEl.value).filter((c) => !keep.has(c));

    const out: string[] = [];
    for (let wi = 0; wi < dict.w.length; wi++) {
      if (bit && !(dict.f[wi] & bit)) continue;
      const w = dict.w[wi];
      let okWord = true;
      for (let i = 0; i < len; i++)
        if (greens[i] && w[i] !== greens[i]) {
          okWord = false;
          break;
        }
      if (okWord)
        for (const c of contains)
          if (!w.includes(c)) {
            okWord = false;
            break;
          }
      if (okWord)
        for (const c of excludes)
          if (w.includes(c)) {
            okWord = false;
            break;
          }
      if (okWord) out.push(w);
    }
    const sort = radio('sort');
    if (sort === 'az') out.sort();
    else if (sort === 'points') out.sort((a, b) => score(b) - score(a) || a.localeCompare(b));
    return out;
  }

  function renderTiles(upTo: number) {
    const showPts = showPointsEl.checked;
    const frag = document.createDocumentFragment();
    for (let i = rendered; i < Math.min(upTo, matches.length); i++) {
      const li = document.createElement('li');
      li.className = 'wtile';
      const word = document.createElement('span');
      word.textContent = matches[i];
      li.appendChild(word);
      if (showPts) {
        const pts = document.createElement('span');
        pts.textContent = String(score(matches[i]));
        li.appendChild(pts);
      }
      frag.appendChild(li);
    }
    results.appendChild(frag);
    rendered = Math.min(upTo, matches.length);
    moreBtn.hidden = rendered >= matches.length;
    const left = matches.length - rendered;
    if (!moreBtn.hidden)
      moreBtn.textContent = `Show more words (${left.toLocaleString('en-US')} left)`;
  }

  function syncDictAvailability() {
    const wordleRadio = form.querySelector<HTMLInputElement>('input[name="dict"][value="wordle"]');
    if (!wordleRadio) return;
    const available = currentLen() === 5;
    wordleRadio.disabled = !available;
    wordleRadio.closest('label')?.classList.toggle('opacity-50', !available);
    if (!available && wordleRadio.checked) setRadio('dict', 'all');
  }

  async function refresh() {
    try {
      const dict = await loadDict(currentLen());
      matches = applyFilter(dict);
      results.replaceChildren();
      rendered = 0;
      countEl.textContent = `${matches.length.toLocaleString('en-US')} words match`;
      renderTiles(initialCount());
    } catch {
      countEl.textContent = 'Could not load the word list. Check your connection and refresh.';
    }
  }

  function scheduleRefresh() {
    window.clearTimeout(timer);
    timer = window.setTimeout(refresh, 60);
  }

  function syncPositions() {
    const len = currentLen();
    posInputs.forEach((el, i) => {
      const active = i < len;
      el.disabled = !active;
      el.classList.toggle('hidden', !active);
      if (!active) el.value = '';
    });
  }

  posInputs.forEach((el, i) => {
    el.addEventListener('input', () => {
      // Keep only the most recent letter so typing overwrites without Backspace.
      el.value = el.value.replace(/[^a-zA-Z]/g, '').slice(-1);
      if (el.value && i + 1 < currentLen()) posInputs[i + 1].focus();
      scheduleRefresh();
    });
    el.addEventListener('focus', () => el.select());
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !el.value && i > 0) posInputs[i - 1].focus();
      else if (e.key === 'ArrowLeft' && i > 0) {
        e.preventDefault();
        posInputs[i - 1].focus();
      } else if (e.key === 'ArrowRight' && i + 1 < currentLen()) {
        e.preventDefault();
        posInputs[i + 1].focus();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        containsEl.focus();
      }
    });
  });

  // Arrow keys also cycle vertically: positions -> contains -> excludes.
  containsEl.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      posInputs[0].focus();
    } else if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
      if (e.key === 'ArrowRight' && containsEl.selectionStart !== containsEl.value.length) return;
      e.preventDefault();
      excludesEl.focus();
    }
  });
  excludesEl.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      containsEl.focus();
    } else if (e.key === 'ArrowLeft' && excludesEl.selectionStart === 0) {
      e.preventDefault();
      containsEl.focus();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      posInputs[0].focus();
    }
  });

  [containsEl, excludesEl].forEach((el) => el.addEventListener('input', scheduleRefresh));

  form.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'len') {
      syncPositions();
      syncDictAvailability();
      refresh();
    } else if (t.name === 'dict' || t.name === 'sort' || t.id === 'show-points') {
      savePrefs();
      refresh();
    }
  });

  form.addEventListener('reset', () => {
    window.setTimeout(() => {
      syncPositions();
      syncDictAvailability();
      refresh();
    }, 0);
  });

  form.addEventListener('submit', (e) => e.preventDefault());

  moreBtn.addEventListener('click', () => renderTiles(rendered + PAGE_SIZE));

  loadPrefs();
  syncPositions();
  syncDictAvailability();
  refresh();
</script>
