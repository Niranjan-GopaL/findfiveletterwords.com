---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const title = 'Page Not Found | Find Five Letter Words';
const description = 'That page does not exist. Try the word finder or browse the word lists.';
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-3xl pt-24 text-center">
    <p class="font-monoui text-xs uppercase tracking-eyebrow">Error 404</p>
    <h1 class="mt-5 text-5xl font-snug tracking-display text-balance">Page not found</h1>
    <p class="mx-auto mt-6 max-w-xl text-lg">
      Five letters, starts with a typo. The page you wanted is not here, but every word list still
      is.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a
        href={url('/')}
        class="rounded-full bg-inverse-canvas px-7 py-3 text-base font-mid text-inverse-ink transition-opacity hover:opacity-85"
      >
        Open the word finder
      </a>
      <a
        href={url('/word-lists/')}
        class="rounded-full border border-hairline px-7 py-3 text-base font-mid transition-colors hover:bg-soft"
      >
        Browse word lists
      </a>
    </div>
  </section>
</BaseLayout>
