---
import '../styles/global.css';
import { LENGTHS, WORD_LISTS, formatCount, sectionFor } from '../lib/words';
import { BASE, IS_PREVIEW_DEPLOY, PROD_ORIGIN, canonicalUrl, url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Render WebSite JSON-LD (home page only). */
  home?: boolean;
}

const { title, description, home = false } = Astro.props;

// Canonical always points at the production domain, even on the temporary
// GitHub Pages deploy, so a stray crawl can never index the preview copy.
const rawPath = Astro.url.pathname;
const path = BASE && rawPath.startsWith(BASE) ? rawPath.slice(BASE.length) || '/' : rawPath;
const canonical = canonicalUrl(path.endsWith('/') || path.includes('.') ? path : `${path}/`);

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Find Five Letter Words',
  url: `${PROD_ORIGIN}/`,
  description:
    'Free word finder and word lists for Wordle, Scrabble, and Words With Friends: every 2-to-20-letter word, sorted by frequency so common words come first.',
};

const navLinks = [
  { href: '/', label: 'Word Finder' },
  { href: '/5-letter-words/', label: '5-Letter Words' },
  { href: '/word-lists/', label: 'Word Lists' },
  { href: '/blog/', label: 'Blog' },
];

const totalWords = formatCount(LENGTHS.reduce((sum, l) => sum + WORD_LISTS[l].length, 0));
// Static ticker shows a hardcoded variant per viewport (no mid-text ellipsis);
// the optional scrolling mode always uses the full text.
const ticker = `${totalWords} words · 2 to 20 letters · sorted by frequency · Scrabble points on every word · free forever`;
const tickerMid = `${totalWords} words · 2 to 20 letters · sorted by frequency`;
const tickerShort = `${totalWords} words · 2 to 20 letters`;

const fontSizes = [
  { value: '', label: 'Default' },
  { value: 'lg', label: 'Large' },
  { value: 'xl', label: 'Larger' },
  { value: 'xxl', label: 'Largest' },
];

/** Remappable single-key shortcuts (defaults; users can rebind in the dialog). */
const shortcuts = [
  { id: 'find', key: '/', action: 'Focus the finder or list filter' },
  { id: 'theme', key: 't', action: 'Toggle dark mode' },
  { id: 'home', key: 'h', action: 'Go to the word finder (home)' },
  { id: 'lists', key: 'w', action: 'Go to the word lists' },
  { id: 'blog', key: 'b', action: 'Go to the blog' },
  { id: 'results', key: 'r', action: 'Jump to the word results' },
  { id: 'faq', key: 'f', action: 'Jump to the FAQs' },
  { id: 'help', key: '?', action: 'Show this help' },
];

const fixedShortcuts = [
  { keys: ['Ctrl', 'F'], action: 'Jump to our filter (press again for the browser find)' },
  { keys: ['←', '→', '↑', '↓'], action: 'Move between the finder boxes' },
  { keys: ['Esc'], action: 'Close dialogs and menus' },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {IS_PREVIEW_DEPLOY && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title="Find Five Letter Words blog" href={url('/rss.xml')} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Find Five Letter Words" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (function () {
        try {
          var theme =
            localStorage.getItem('fflw-theme') ||
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
          var size = localStorage.getItem('fflw-fontsize');
          if (size) document.documentElement.dataset.fontsize = size;
          if (localStorage.getItem('fflw-marquee') === 'on')
            document.documentElement.dataset.marquee = 'on';
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    {home && <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-inverse-canvas focus:px-4 focus:py-2 focus:text-sm focus:font-mid focus:text-inverse-ink"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-hairline bg-canvas">
      <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-3 px-4">
        <a href={url('/')} class="rounded-xs text-lg font-snug tracking-display whitespace-nowrap" translate="no">
          Find Five Letter Words
        </a>
        <nav aria-label="Primary" class="max-md:hidden">
          <ul class="flex items-center gap-1">
            {
              navLinks.map((l) => (
                <li>
                  <a class="block rounded-full px-3.5 py-2 text-base font-mid transition-colors hover:bg-soft" href={url(l.href)}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="flex items-center gap-2">
          <details id="fontsize-menu" class="relative">
            <summary
              class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full bg-soft text-sm font-snug transition-colors hover:bg-hairline-soft [&::-webkit-details-marker]:hidden"
              aria-label="Text size"
            >
              Aa
            </summary>
            <div class="absolute right-0 top-12 z-50 w-40 rounded-2xl border border-hairline bg-canvas p-1.5">
              <p class="px-2.5 pb-1 pt-1.5 font-monoui text-xs uppercase tracking-eyebrow">Text size</p>
              {
                fontSizes.map((s) => (
                  <button
                    type="button"
                    data-size={s.value}
                    class="fontsize-option block w-full rounded-lg px-2.5 py-2 text-left text-base font-mid transition-colors hover:bg-soft aria-pressed:bg-soft"
                    aria-pressed={s.value === '' ? 'true' : 'false'}
                  >
                    {s.label}
                  </button>
                ))
              }
            </div>
          </details>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            class="flex size-10 items-center justify-center rounded-full bg-soft transition-colors hover:bg-hairline-soft"
          >
            <svg class="icon-moon size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg class="icon-sun size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
          </button>
          <button
            id="menu-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="flex size-10 items-center justify-center rounded-full bg-soft transition-colors hover:bg-hairline-soft md:hidden"
          >
            <svg class="size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </div>
      <nav id="mobile-menu" aria-label="Mobile" hidden class="border-t border-hairline md:hidden">
        <ul class="mx-auto max-w-7xl px-4 py-2">
          {
            navLinks.map((l) => (
              <li>
                <a class="block rounded-md px-2 py-3 text-lg font-mid hover:bg-soft" href={url(l.href)}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <!-- Stats ticker. Static by default; the button turns the classic
         scrolling-marquee mode on for people who like it. -->
    <div class="relative flex h-9 items-center overflow-hidden bg-navy">
      <p class="marquee-track font-monoui text-xs uppercase tracking-eyebrow text-white" aria-hidden="true">
        <span class="t-full">{ticker}</span>
        <span class="t-mid">{tickerMid}</span>
        <span class="t-short">{tickerShort}</span>
        <span class="t-dup">{ticker}</span>
      </p>
      <button
        id="marquee-toggle"
        type="button"
        aria-pressed="false"
        aria-label="Toggle ticker animation"
        class="absolute right-2 top-1/2 flex size-6 -translate-y-1/2 items-center justify-center rounded-full text-white/70 transition-colors hover:bg-white/15 hover:text-white"
      >
        <svg class="icon-play size-3.5" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"></path>
        </svg>
        <svg class="icon-pause size-3.5" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 5h4v14H6zM14 5h4v14h-4z"></path>
        </svg>
      </button>
    </div>

    <main id="main" class="mx-auto max-w-7xl px-4">
      <slot />
    </main>

    <footer class="mt-24 border-t border-hairline">
      <div class="mx-auto max-w-7xl px-4 py-14">
        <p class="text-2xl font-snug tracking-display" translate="no">Find Five Letter Words</p>
        <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          <div class="sm:col-span-2">
            <h2 class="font-monoui text-xs uppercase tracking-eyebrow">Word lists by length</h2>
            <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 text-base">
              {
                LENGTHS.map((l) => (
                  <li>
                    <a class="rounded-xs font-mid hover:underline" href={url(`/${sectionFor(l)}/`)}>
                      {l}-letter words
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h2 class="font-monoui text-xs uppercase tracking-eyebrow">Popular</h2>
            <ul class="mt-4 space-y-2 text-base">
              <li><a class="rounded-xs font-mid hover:underline" href={url('/')}>Word finder &amp; solver</a></li>
              <li><a class="rounded-xs font-mid hover:underline" href={url('/5-letter-words/with-no-repeated-letters/')}>Best Wordle starter words</a></li>
              <li><a class="rounded-xs font-mid hover:underline" href={url('/5-letter-words/without-vowels/')}>Words without vowels</a></li>
              <li><a class="rounded-xs font-mid hover:underline" href={url('/2-letter-words/')}>Two-letter Scrabble words</a></li>
              <li><a class="rounded-xs font-mid hover:underline" href={url('/blog/')}>Blog</a></li>
            </ul>
          </div>
          <div>
            <h2 class="font-monoui text-xs uppercase tracking-eyebrow">Site</h2>
            <ul class="mt-4 space-y-2 text-base">
              <li><a class="rounded-xs font-mid hover:underline" href={url('/about/')}>About</a></li>
              <li><a class="rounded-xs font-mid hover:underline" href={url('/privacy-policy/')}>Privacy policy</a></li>
              <li><a class="rounded-xs font-mid hover:underline" href={url('/contact/')}>Contact</a></li>
              <li><a class="rounded-xs font-mid hover:underline" href={url('/rss.xml')}>RSS feed</a></li>
            </ul>
          </div>
        </div>
        <p class="mt-12 border-t border-hairline-soft pt-6 font-monoui text-xs uppercase tracking-eyebrow">
          © {year} findfiveletterwords.com · Not affiliated with the New York Times, Wordle, or Scrabble
          · Press <kbd class="rounded border border-hairline bg-soft px-1.5 py-0.5">?</kbd> for keyboard shortcuts
        </p>
      </div>
    </footer>

    <dialog
      id="kbd-help"
      class="m-auto w-[min(92vw,30rem)] rounded-3xl border border-hairline bg-canvas p-6 text-ink backdrop:bg-black/50"
    >
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-xl font-snug tracking-display">Keyboard shortcuts</h2>
        <button
          id="kbd-close"
          type="button"
          aria-label="Close"
          class="flex size-9 items-center justify-center rounded-full bg-soft transition-colors hover:bg-hairline-soft"
        >
          <svg class="size-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
      <p class="mt-3 text-sm font-soft">
        Click a key to choose your own binding. It is saved on this device, so it wins over
        anything your browser or extensions use.
      </p>
      <dl class="mt-4 space-y-3">
        {
          shortcuts.map((s) => (
            <div class="flex items-center justify-between gap-6">
              <dt class="text-base">{s.action}</dt>
              <dd class="shrink-0">
                <button
                  type="button"
                  class="kbd-rebind rounded-md border border-hairline bg-soft px-2 py-1 font-monoui text-xs uppercase transition-colors hover:border-ink"
                  data-action={s.id}
                  data-default={s.key}
                  aria-label={`Change the key for: ${s.action}`}
                >
                  {s.key}
                </button>
              </dd>
            </div>
          ))
        }
        {
          fixedShortcuts.map((s) => (
            <div class="flex items-center justify-between gap-6">
              <dt class="text-base">{s.action}</dt>
              <dd class="flex shrink-0 gap-1">
                {s.keys.map((k) => (
                  <kbd class="rounded-md border border-hairline bg-soft px-2 py-1 font-monoui text-xs">{k}</kbd>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
      <button
        id="kbd-reset"
        type="button"
        class="mt-5 rounded-full border border-hairline px-4 py-1.5 text-sm font-mid transition-colors hover:bg-soft"
      >
        Reset keys to defaults
      </button>
    </dialog>

    <style>
      html[data-theme='dark'] .icon-sun {
        display: block;
      }
      html[data-theme='dark'] .icon-moon {
        display: none;
      }
      html:not([data-theme='dark']) .icon-sun {
        display: none;
      }
      html[data-marquee='on'] .icon-play {
        display: none;
      }
      html:not([data-marquee='on']) .icon-pause {
        display: none;
      }
    </style>

    <script>
      /* Theme toggle */
      const themeBtn = document.getElementById('theme-toggle');
      const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      function syncThemeMeta() {
        if (themeMeta)
          themeMeta.content =
            document.documentElement.dataset.theme === 'dark' ? '#141417' : '#ffffff';
      }
      syncThemeMeta();
      themeBtn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('fflw-theme', next);
        } catch {
          /* private mode */
        }
        syncThemeMeta();
      });

      /* Text size */
      const sizeMenu = document.getElementById('fontsize-menu') as HTMLDetailsElement | null;
      const sizeButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('.fontsize-option'),
      );
      function syncSizeButtons() {
        const current = document.documentElement.dataset.fontsize ?? '';
        sizeButtons.forEach((b) =>
          b.setAttribute('aria-pressed', String((b.dataset.size ?? '') === current)),
        );
      }
      syncSizeButtons();
      sizeButtons.forEach((b) =>
        b.addEventListener('click', () => {
          const size = b.dataset.size ?? '';
          if (size) document.documentElement.dataset.fontsize = size;
          else delete document.documentElement.dataset.fontsize;
          try {
            if (size) localStorage.setItem('fflw-fontsize', size);
            else localStorage.removeItem('fflw-fontsize');
          } catch {
            /* private mode */
          }
          syncSizeButtons();
          if (sizeMenu) sizeMenu.open = false;
        }),
      );
      document.addEventListener('click', (e) => {
        if (sizeMenu?.open && !sizeMenu.contains(e.target as Node)) sizeMenu.open = false;
      });

      /* Ticker: static by default, classic marquee on request */
      const marqueeBtn = document.getElementById('marquee-toggle');
      function syncMarqueeBtn() {
        marqueeBtn?.setAttribute(
          'aria-pressed',
          String(document.documentElement.dataset.marquee === 'on'),
        );
      }
      syncMarqueeBtn();
      marqueeBtn?.addEventListener('click', () => {
        const on = document.documentElement.dataset.marquee === 'on';
        if (on) delete document.documentElement.dataset.marquee;
        else document.documentElement.dataset.marquee = 'on';
        try {
          if (on) localStorage.removeItem('fflw-marquee');
          else localStorage.setItem('fflw-marquee', 'on');
        } catch {
          /* private mode */
        }
        syncMarqueeBtn();
      });

      /* Mobile menu */
      const menuBtn = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      menuBtn?.addEventListener('click', () => {
        const open = menu!.hidden;
        menu!.hidden = !open;
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      });

      /* ------------------------------------------------------------ */
      /* Keyboard shortcuts: single-key actions, remappable in the     */
      /* help dialog, persisted per device in localStorage.            */
      /* ------------------------------------------------------------ */
      const BASE_URL = import.meta.env.BASE_URL.replace(/\/$/, '');
      const kbdDialog = document.getElementById('kbd-help') as HTMLDialogElement | null;
      document.getElementById('kbd-close')?.addEventListener('click', () => kbdDialog?.close());
      kbdDialog?.addEventListener('click', (e) => {
        if (e.target === kbdDialog) kbdDialog.close();
      });

      function findTarget(): HTMLInputElement | null {
        return (document.getElementById('wg-filter') ??
          document.getElementById('pos-1')) as HTMLInputElement | null;
      }
      function jumpTo(id: string) {
        const el = document.getElementById(id);
        el?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      const ACTIONS: Record<string, () => void> = {
        find: () => {
          const el = findTarget();
          el?.focus();
          el?.select?.();
        },
        theme: () => themeBtn?.click(),
        home: () => location.assign(`${BASE_URL}/`),
        lists: () => location.assign(`${BASE_URL}/word-lists/`),
        blog: () => location.assign(`${BASE_URL}/blog/`),
        results: () => jumpTo(document.getElementById('results') ? 'results' : 'wg'),
        faq: () => jumpTo('faq'),
        help: () => kbdDialog?.showModal(),
      };

      const KEYS_STORE = 'fflw-keys';
      const rebindBtns = Array.from(
        document.querySelectorAll<HTMLButtonElement>('.kbd-rebind'),
      );
      function loadKeyOverrides(): Record<string, string> {
        try {
          return JSON.parse(localStorage.getItem(KEYS_STORE) ?? '{}');
        } catch {
          return {};
        }
      }
      function saveKeyOverrides(map: Record<string, string>) {
        try {
          localStorage.setItem(KEYS_STORE, JSON.stringify(map));
        } catch {
          /* private mode */
        }
      }
      function keyFor(action: string): string {
        const overrides = loadKeyOverrides();
        return (
          overrides[action] ??
          rebindBtns.find((b) => b.dataset.action === action)?.dataset.default ??
          ''
        );
      }
      function syncRebindLabels() {
        rebindBtns.forEach((b) => (b.textContent = keyFor(b.dataset.action!)));
      }
      syncRebindLabels();

      let rebinding: HTMLButtonElement | null = null;
      rebindBtns.forEach((b) =>
        b.addEventListener('click', () => {
          if (rebinding) rebinding.textContent = keyFor(rebinding.dataset.action!);
          rebinding = b;
          b.textContent = 'press a key';
        }),
      );
      document.getElementById('kbd-reset')?.addEventListener('click', () => {
        saveKeyOverrides({});
        rebinding = null;
        syncRebindLabels();
      });
      kbdDialog?.addEventListener('close', () => {
        if (rebinding) {
          rebinding.textContent = keyFor(rebinding.dataset.action!);
          rebinding = null;
        }
      });

      document.addEventListener('keydown', (e) => {
        // Capture mode: the next plain keypress becomes the new binding.
        if (rebinding) {
          e.preventDefault();
          e.stopPropagation();
          if (e.key !== 'Escape' && e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
            const newKey = e.key.toLowerCase();
            const action = rebinding.dataset.action!;
            const overrides = loadKeyOverrides();
            // If another action already uses this key, swap so nothing is lost.
            for (const other of rebindBtns) {
              const otherAction = other.dataset.action!;
              if (otherAction !== action && keyFor(otherAction) === newKey) {
                overrides[otherAction] = keyFor(action);
              }
            }
            overrides[action] = newKey;
            saveKeyOverrides(overrides);
          }
          rebinding = null;
          syncRebindLabels();
          return;
        }

        const t = e.target as HTMLElement;
        const typing =
          t &&
          (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable);

        // Custom Ctrl/Cmd+F: jump to our filter; press again for the browser find.
        if ((e.ctrlKey || e.metaKey) && !e.altKey && e.key.toLowerCase() === 'f') {
          const el = findTarget();
          if (el && document.activeElement !== el) {
            e.preventDefault();
            el.focus();
            el.select?.();
          }
          return;
        }
        if (e.ctrlKey || e.metaKey || e.altKey || typing) return;
        if (e.key.length !== 1) return;

        const pressed = e.key === '?' ? '?' : e.key.toLowerCase();
        for (const b of rebindBtns) {
          const action = b.dataset.action!;
          if (keyFor(action) === pressed) {
            e.preventDefault();
            ACTIONS[action]?.();
            return;
          }
        }
      });
    </script>
  </body>
</html>
