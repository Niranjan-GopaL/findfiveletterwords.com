---
import type { Faq } from '../lib/pages';

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="mt-16 rounded-3xl bg-lime p-6 text-blockink sm:p-12 max-sm:-mx-4 max-sm:rounded-none">
  <h2 class="text-2xl font-snug tracking-display text-balance sm:text-3xl">
    Frequently asked questions
  </h2>
  <div class="mt-2">
    {
      faqs.map((f) => (
        <div class="mt-6 border-t border-blockink/15 pt-6">
          <h3 class="text-lg font-snug text-balance">{f.q}</h3>
          <p class="mt-3 max-w-3xl">{f.a}</p>
        </div>
      ))
    }
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
