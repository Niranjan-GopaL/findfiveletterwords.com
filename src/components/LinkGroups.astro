---
import type { LinkGroup } from '../lib/pages';
import { url } from '../lib/url';

interface Props {
  groups: LinkGroup[];
}

const { groups } = Astro.props;
---

{
  groups.map((g) => (
    <section class="mt-14">
      <h2 class="text-xl font-snug tracking-display text-balance sm:text-2xl">{g.heading}</h2>
      <ul class="mt-5 flex flex-wrap gap-2">
        {g.links.map((l) => (
          <li>
            <a
              href={url(l.href)}
              class="block rounded-full border border-hairline px-3.5 py-2 text-sm font-mid transition-colors hover:bg-soft"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))
}
